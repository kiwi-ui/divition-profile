{
  "rewrites": [
    {
      "source": "/jualtanah",
      "destination": "https://jualtanah.vercel.app/"
    },
    {
      "source": "/jualtanah/:path*",
      "destination": "https://jualtanah.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}